# Copy to .env and fill in the values.

DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions.
AUTH_SECRET=""

# Admin account created (or updated) by the seed script.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Optional: address that receives admin notification emails.
ADMIN_EMAIL=""

# Optional: persistent folder for uploaded images (e.g. /home/data/uploads on Azure App Service).
UPLOAD_DIR=""

# Optional: SMTP settings for email notifications.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
